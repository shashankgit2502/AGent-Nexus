# Keep the build context small + reproducible (deps come from the lockfile).
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
# Local object storage (uploaded knowledge files / chat attachments) — never baked in.
var/
# Local env + secrets — provided at runtime, never in the image.
.env
.env.*
# Tests are not needed in the runtime image.
tests/
